# ==========================================
# 1. 通用系统、IDE 与临时文件
# ==========================================
# 操作系统隐性文件
.DS_Store
.DS_Store?
ehthumbs.db
Thumbs.db

# IDE / 编辑器配置目录
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# 临时脚本、日志与测试 HTTP 请求文件
*.sh
*.log
*.http

# ==========================================
# 2. Vue 3 前端 (frontend-vue) 过滤规则
# ==========================================
# 绝不能提交前端第三方依赖库（极重）
node_modules/

# Vite / Vue 编译打包输出目录
dist/
dist-ssr/

# 本地开发与测试产物
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# 3. Spring Boot Java 后端 (backend-spring) 过滤规则
# ==========================================
# Maven / Gradle 编译构建输出目录
target/
build/
out/

# Maven 依赖与包装器日志
.mvn/
!.mvn/wrapper/maven-wrapper.jar

# ==========================================
# 4. Python AI 引擎 (ai-engine) 过滤规则
# ==========================================
# Python 字节码与缓存
__pycache__/
*.py[cod]
*$py.class

# Python 虚拟环境目录
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# 环境变量与敏感 Key 配置文件（绝对不能上提交）
.env
*.env
!.env.example

# pytest / 单元测试产物
.pytest_cache/
.coverage
htmlcov/